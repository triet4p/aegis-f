# Machine-specific Android SDK location
/local.properties

# Gradle and Android build output
.gradle/
**/.gradle/
**/build/
**/captures/
.externalNativeBuild/
.cxx/
.kotlin/
*.apk
*.aab
*.hprof

# IDE-local state
.idea/
*.iml

# Credentials and signing material
.env
.env.*
key.properties
signing.properties
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.p8
*.key

# Locally supplied ML model binaries
models/
**/models/
*.onnx
*.gguf
*.tflite
*.safetensors
*.pt
*.pth
*.ort
*.model
*.task
*.mlmodel
*.litertlm
*.bin

# The Laya tokenizer asset is derived data, not model weights: it carries only the
# pinned public tokenizer's vocab/merges/added-token table (1.3 MB, reproducible via
# `tools/laya/export_tokenizer_asset.py`) and no graph weights, so the runtime can load
# it without parsing JSON on-device. The graph itself (`*.onnx`, external weights) stays
# out of Git and arrives via S4.3 provisioning instead.
!app/src/main/assets/laya/laya_tokenizer.bin

__pycache__/
*.py[cod]

# Local machine-readable evaluation output and per-case device runs; retain locally only.
