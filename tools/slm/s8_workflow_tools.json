{
  "schema":"aegis-f-s8-workflow-tools/v1",
  "additionalProperties":false,
  "tools":[
    {"name":"query_draft_candidates","description":"Read a bounded page of stored bank drafts. This query filters review state and possible-duplicate status only; it does not assert a match.","parameters":{"type":"object","additionalProperties":false,"required":["query"],"properties":{"query":{"type":"object","additionalProperties":false,"required":["reviewStatus","onlyPossibleDuplicates","bounds"],"properties":{"reviewStatus":{"type":["string","null"],"enum":["PENDING","CONFIRMED","DISMISSED",null]},"onlyPossibleDuplicates":{"type":"boolean"},"bounds":{"$ref":"#/$defs/page"}}}}},"mapsTo":"WorkflowQueryService.draftCandidates(DraftCandidateQuery)"},
    {"name":"update_event_interpretation","description":"Store or revise one reading of a source span. Null means not stated; do not guess. A missing required value may be recorded with unresolvedReason and clarified with the user.","parameters":{"type":"object","additionalProperties":false,"required":["idempotencyKey","captureId","expectedCaptureRevision","interpretation","extractionVersion","expectedEventRevision"],"properties":{"idempotencyKey":{"type":"string","minLength":1},"captureId":{"type":"integer","minimum":1},"expectedCaptureRevision":{"type":"integer","minimum":0},"interpretation":{"type":"object","additionalProperties":false,"required":["spanStart","spanEnd","normalizedText"],"properties":{"spanStart":{"type":"integer","minimum":0},"spanEnd":{"type":"integer","minimum":1},"normalizedText":{"type":"string","minLength":1},"amountVnd":{"type":["integer","null"],"minimum":1},"merchant":{"type":["string","null"]},"timeAnchor":{"type":["object","null"],"additionalProperties":false,"properties":{"date":{"type":["string","null"],"format":"date"},"time":{"type":["string","null"],"pattern":"^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},"timezoneId":{"type":["string","null"]},"intervalEndDate":{"type":["string","null"],"format":"date"},"intervalEndTime":{"type":["string","null"],"pattern":"^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}}},"unresolvedReason":{"type":["string","null"]}}},"extractionVersion":{"type":"string","minLength":1},"expectedEventRevision":{"type":["integer","null"],"minimum":0}}},"mapsTo":"WorkflowCommandService.updateEventInterpretation(scope, UpdateEventRequest)"},
    {"name":"propose_link","description":"Propose an event/draft association. The app computes link evidence from stored source and draft data; caller-supplied evidence is forbidden.","parameters":{"type":"object","additionalProperties":false,"required":["idempotencyKey","eventId","draftId"],"properties":{"idempotencyKey":{"type":"string","minLength":1},"eventId":{"type":"integer","minimum":1},"draftId":{"type":"integer","minimum":1}}},"mapsTo":"WorkflowCommandService.proposeLink(scope, ProposeLinkRequest)"},
    {"name":"attach_link","description":"Attach only a previously proposed pair. Agent scope is subject to the application's unchanged evidence policy; ambiguity remains for the user.","parameters":{"type":"object","additionalProperties":false,"required":["idempotencyKey","eventId","draftId","expectedRevision","userOverride"],"properties":{"idempotencyKey":{"type":"string","minLength":1},"eventId":{"type":"integer","minimum":1},"draftId":{"type":"integer","minimum":1},"expectedRevision":{"type":"integer","minimum":0},"userOverride":{"type":["string","null"]}}},"mapsTo":"WorkflowCommandService.attachLink(scope, AttachLinkRequest)"},
    {"name":"request_laya_classification","description":"Request the existing review-only Laya suggestion for one draft and the exact review text; this does not choose a category or write a ledger record.","parameters":{"type":"object","additionalProperties":false,"required":["idempotencyKey","draftId","description","expectedReviewRevision"],"properties":{"idempotencyKey":{"type":"string","minLength":1},"draftId":{"type":"integer","minimum":1},"description":{"type":"string"},"expectedReviewRevision":{"type":["integer","null"],"minimum":0}}},"mapsTo":"WorkflowCommandService.requestClassification(scope, ClassificationRequest)"}
  ],
  "$defs":{"page":{"type":"object","additionalProperties":false,"required":["limit","offset"],"properties":{"limit":{"type":"integer","minimum":1,"maximum":500,"description":"Maximum number of drafts in the page; integer from 1 through 500."},"offset":{"type":"integer","minimum":0,"description":"Zero-based page offset; non-negative integer."}}}}
}
