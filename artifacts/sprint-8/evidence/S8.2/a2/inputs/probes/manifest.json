{
  "derivation": "each probe starts from inputs/semantic-variant.json and applies one mutation",
  "diagnostic_only": "scorer mutation probes; effects are the preserved S8.3-a2 diagnostic values",
  "probes": [
    {
      "input": "probes/mut-empty-key.json",
      "expected_reason": "idempotency_key_invalid"
    },
    {
      "input": "probes/mut-whitespace-key.json",
      "expected_reason": "idempotency_key_invalid"
    },
    {
      "input": "probes/mut-changed-scope.json",
      "expected_reason": "call_intent_or_arguments_mismatch"
    },
    {
      "input": "probes/mut-changed-revision.json",
      "expected_reason": "call_intent_or_arguments_mismatch"
    },
    {
      "input": "probes/mut-changed-amount.json",
      "expected_reason": "call_intent_or_arguments_mismatch"
    },
    {
      "input": "probes/mut-changed-date.json",
      "expected_reason": "call_intent_or_arguments_mismatch"
    },
    {
      "input": "probes/mut-changed-time.json",
      "expected_reason": "call_intent_or_arguments_mismatch"
    },
    {
      "input": "probes/mut-changed-intent.json",
      "expected_reason": "call_intent_or_arguments_mismatch"
    },
    {
      "input": "probes/mut-extra-call.json",
      "expected_reason": "call_intent_or_arguments_mismatch"
    },
    {
      "input": "probes/mut-missing-effects.json",
